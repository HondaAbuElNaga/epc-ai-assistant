ANTHROPIC_API_KEY=your-key-here

# Which LLM backend to use: anthropic (Claude API, external) | fake (offline, for tests)
LLM_PROVIDER=anthropic

# public | confidential. "confidential" blocks every external provider (e.g. anthropic).
DATA_CLASSIFICATION=public

# Optional: override the model behind each tier (<PROVIDER>_MODEL_<TIER>)
# ANTHROPIC_MODEL_MAIN=claude-sonnet-5-5
# ANTHROPIC_MODEL_FAST=claude-haiku-4-5
